{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "homepage": "/",
  "scripts": {
    "start": "BROWSER=none react-scripts start",
    "menuconfig": "cd .. && pio run -t menuconfig",
    "cleanSDKConfig": "../sdkconfigs/sdkconfig.sh",
    "clean": " npm run cleanSDKConfig && cd .. && pio run -t clean",
    "build": "GENERATE_SOURCEMAP=false BUILD_PATH='../data' react-scripts build && rm ../data/static/js/*.LICENSE.txt",
    "monitor": "cd .. && pio device monitor --filter esp32_exception_decoder",
    "upload": "cd .. && pio run -t upload && pio device monitor --filter esp32_exception_decoder",
    "uploadfs": "cd .. && pio run -t uploadfs && pio device monitor --filter esp32_exception_decoder",
    "update": "cd .. && pio run -t uploadfs && pio run -t upload && pio device monitor --filter esp32_exception_decoder",
    "deploy": "pnpm run clean && pnpm run build && pnpm run update",
    "secure:status": "cd .. && espefuse --port /dev/cu.usbmodem101 summary || echo 'Secure boot enabled (cannot read eFuse)'",
    "secure:gen-key": "cd .. && espsecure generate-signing-key --version 2 --scheme ecdsa256 secure_boot/ecdsa_signing_key.pem",
    "secure:verify": "cd .. && esptool --chip esp32c3 --port /dev/cu.usbmodem101 chip_id",
    "helm:deploy": "helm upgrade --install espwifi-io ../espwifi.io -f ../espwifi.io/values.yaml --namespace espwifi-io --create-namespace"
  },
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mediabunny/ac3": "1.66.5",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "mediabunny": "^1.66.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-scripts": "^5.0.1",
    "web-vitals": "^4.2.4"
  },
  "eslintConfig": {
    "rules": {
      "react-hooks/exhaustive-deps": "off"
    },
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}