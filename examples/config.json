{
    "deviceName": "ESPWiFi",
    "wifi": {
        "enabled": true,
        "mode": "client",
        "mdns": true,
        "accessPoint": {
            "password": "espWiFi#"
        },
        "client": {
            "ssid": "exampleSSID",
            "password": "examplePassword123"
        },
        "power": {
            "txPower": 19.5,
            "powerSave": "none"
        }
    },
    "ble": {
        "enabled": true
    },
    "log": {
        "file": "NONE",
        "level": "debug",
        "enabled": true,
        "useSD": true,
        "maskedKeys": [
            "password",
            "token"
        ]
    },
    "openai": {
        "apiKey": "sk-proj-EXAMPLE-KEY",
        "model": "gpt-4o-mini",
        "baseUrl": "https://api.openai.com",
        "systemMessage": "You are a HAM Radio Operator. You are operating a radio station and you are the assistant for the radio station. Your call sign is WSCE496. Follow standard HAM radio protocol with all responses.",
        "ttsModel": "tts-1",
        "ttsVoice": "alloy",
        "ttsTimeoutMs": 60000,
        "ttsSpeed": 1.0
    },
    "auth": {
        "enabled": false,
        "password": "admin",
        "username": "admin",
        "cors": {
            "enabled": true,
            "origins": [
                "https://espwifi.io",
                "*"
            ],
            "methods": [
                "GET",
                "POST",
                "PUT"
            ]
        },
        "excludePaths": [
            "/",
            "/static/*",
            "/favicon.ico",
            "/api/auth/login",
            "/asset-manifest.json"
        ],
        "protectedFiles": [
            "static/*",
            "index.html",
            "config.json",
            "asset-manifest.json"
        ]
    }
}