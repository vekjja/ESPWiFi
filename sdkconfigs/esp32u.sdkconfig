# ========================================================================================
# ESP-32U Module Configuration
# ESP32-WROOM-32U (external antenna), 4MB flash, no PSRAM
# Headless: no onboard TFT, touch, or SD card

# Main task stack (no LVGL/TFT UI on module-only builds)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Task stacks and buffers (no LVGL; use defaults for sys_evt/tcpip, trim WiFi only)
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_MDNS_MAX_SERVICES=8

# SquareLine UI sources still compile on headless builds; enable referenced fonts only
CONFIG_LV_FONT_MONTSERRAT_36=y

# Optimization (size optimized for Classic ESP32; required to fit IRAM/DRAM with WiFi on classic ESP32)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
# Free IRAM: WiFi and heap in flash (slight perf cost)
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/espwifi_esp32u.csv"

# CPU Configuration (ESP32 dual-core)
CONFIG_ESP32_DEFAULT_CPU_FREQ_160=y
CONFIG_ESP32_REV_MIN_3=y
# CONFIG_FREERTOS_UNICORE is not set

# Flash Configuration (ESP-IDF / esptoolpy)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Bluetooth disabled on ESP-32U (enable in sdkconfigs/cyd.sdkconfig for A2DP builds)
# CONFIG_BT_ENABLED is not set
